# =============================================================================
# FRONTEND (Vite) — copy values into repo root `.env` or `.env.local`
# Vite only exposes variables prefixed with VITE_. Restart `npm run dev` after edits.
# =============================================================================

# Dev only: where the Vite dev server proxies /api (see server/.env PORT).
# Not used by `npm run build` — a production build calls /api on its own
# origin, which nginx proxies to the backend (docs/DEPLOY-WINDOWS.md).
VITE_BACKEND_URL=http://localhost:3100

# Production only, and only if the API is on a different origin than the
# site itself (it normally isn't). Leave unset for the standard nginx setup.
# VITE_API_ORIGIN=https://api.example.com

# Two-factor login uses Google Authenticator (TOTP) — no frontend config needed.
# Admins enroll users from Settings → Users; server settings live in server/.env.

# Google Places Autocomplete for the Locator business-address field. Needs
# the "Places API" enabled on the Google Cloud project the key belongs to.
VITE_GOOGLE_MAPS_API_KEY=

# =============================================================================
# BACKEND — do NOT put JWT/DB secrets here.
# Use server/.env instead (see server/.env.example).
# =============================================================================

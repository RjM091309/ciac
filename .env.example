# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AIzaSyBimQ5xKcdqoAQTloNUmhXyWJsJX9fBmCE"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
VITE_BACKEND_URL=http://localhost:3100
# Firebase (frontend/Vite)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
# Dev-only: set true only when using Firebase test phone numbers.
VITE_FIREBASE_PHONE_AUTH_TEST_MODE="false"

# Firebase Admin (backend/server)
# Prefer one of these:
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'
# FIREBASE_SERVICE_ACCOUNT_BASE64="BASE64_ENCODED_SERVICE_ACCOUNT_JSON"

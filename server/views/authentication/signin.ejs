<section class="auth">
  <div class="auth-left">
    <div class="auth-hero">
      <div class="brand">
        <div class="brand-mark">CIAC</div>
        <div class="brand-sub">Locator & Compliance Portal</div>
      </div>
      <div class="hero-copy">
        <h2>Welcome back</h2>
        <p>Sign in to continue to your dashboard.</p>
      </div>
    </div>
  </div>

  <div class="auth-right">
    <div class="card">
      <div class="card-head">
        <h4>Sign In to your Account</h4>
        <p class="muted">Please enter your details.</p>
      </div>

      <script>
        window.__FRONTEND_URL__ = "<%= (typeof FRONTEND_URL !== 'undefined' && FRONTEND_URL) ? FRONTEND_URL : '' %>";
      </script>
      <form id="login_form" autocomplete="off">
        <div class="field">
          <label for="username">Username</label>
          <input id="username" type="text" name="username" placeholder="Username" required />
        </div>

        <div class="field" id="password-field">
          <label for="password">Password</label>
          <div class="password-wrap">
            <input id="password" type="password" name="password" placeholder="Password" required />
            <button class="ghost" type="button" id="togglePassword">Show</button>
          </div>
        </div>

        <div class="row">
          <label class="check">
            <input type="checkbox" id="admin-login-toggle" />
            <span>Admin Login Mode</span>
          </label>
          <a class="link" href="#" onclick="return false;">Forgot Password?</a>
        </div>

        <button type="submit" class="btn-primary" id="submitBtn">Sign In</button>

        <div class="hint">
          <span id="formMessage" role="status" aria-live="polite"></span>
        </div>
      </form>
    </div>
  </div>
</section>


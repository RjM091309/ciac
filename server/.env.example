# =============================================================================
# BACKEND (Express) — copy to server/.env and fill in real values.
# Loaded by server/app.js via path server/.env (not root .env.local).
# =============================================================================

PORT=3100
NODE_ENV=development

JWT_SECRET=change-me-to-a-long-random-string

# Key for encrypting sensitive columns at rest (proponents.tin; lib/crypto.js).
# Falls back to JWT_SECRET when unset — which ties encrypted data to the JWT
# secret: rotating JWT_SECRET later would make every stored TIN unreadable.
# Set this on every new install. On a server that already has data encrypted
# without it, set it to the CURRENT JWT_SECRET value first (same key, nothing
# to migrate); JWT_SECRET can then be rotated freely.
# APP_ENC_KEY=change-me-to-a-long-random-string

# Account lockout after repeated failed sign-ins (wrong password or wrong
# authenticator code), admin accounts included. A locked account unlocks by
# itself after LOGIN_LOCKOUT_MINUTES, or when an admin reactivates it.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# Where uploaded documents and generated certificates are stored.
# Default: server/uploads. Back this directory up with the database.
# STORAGE_DIR=/var/lib/ciac/uploads

# CORS: Vite dev server origin(s), comma-separated if multiple.
FRONTEND_URL=http://localhost:2500
# Extra allowed origins (CORS + CSRF check), comma-separated.
# FRONTEND_ORIGINS=https://portal.example.com,https://www.portal.example.com

# Which proxy's X-Forwarded-For header to trust for the client IP (audit log).
# Default "loopback" fits a proxy on this same machine (Vite / IIS / nginx).
# If the reverse proxy is on another host, set its IP or subnet instead.
# TRUST_PROXY=loopback

# --- SQL Server (see server/config/database.js) ---
# DB_SERVER=localhost
# DB_NAME=your_database
# DB_TRUSTED_CONNECTION=true
# DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
#
# Or SQL auth:
# DB_SERVER=localhost
# DB_NAME=your_database
# DB_TRUSTED_CONNECTION=false
# DB_USER=sa
# DB_PASSWORD=your_password

# --- Two-factor login (Google Authenticator / TOTP) ---
# Name shown in the user's authenticator app next to the code.
TOTP_ISSUER=CIAC Portal
# Optional: 32+ char random string used to encrypt stored TOTP secrets at rest.
# If omitted, a key derived from JWT_SECRET is used (rotating JWT_SECRET then
# invalidates existing authenticator enrollments — set this to decouple them).
# Same caveat as APP_ENC_KEY: on a server with existing enrollments, set it to
# the current JWT_SECRET value, or everyone must re-enroll.
# TOTP_ENC_KEY=change-me-to-a-long-random-string

# Optional SMTP (server/config/mailer.js)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Sender address; defaults to SMTP_USER.
# SMTP_FROM="3CORE Portal <no-reply@example.com>"
